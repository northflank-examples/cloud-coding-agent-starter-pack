# Copy to .env, then uncomment and fill in what you need. Never commit .env.
# Leave unused lines commented out: an empty KEY= still sets the variable.

# Repository the agent works on (HTTPS URL)
REPO_URL=https://github.com/your-org/your-repo.git
# REPO_BRANCH=main

# Fine-grained token scoped to REPO_URL only:
# Contents: read/write, Pull requests: read/write
# GITHUB_TOKEN=github_pat_...

# ---- Agent credentials: set the ones for the agents you run ----
# claude-code:  ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...
# codex:        CODEX_API_KEY
# CODEX_API_KEY=sk-...
# cursor-cli:   CURSOR_API_KEY
# CURSOR_API_KEY=...
# opencode, pi, omp, crush, aider, goose: the provider's own key (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...)
# OPENAI_API_KEY=sk-...
# OPENCODE_MODEL=anthropic/claude-sonnet-5-5
# PI_MODEL=anthropic/claude-sonnet-5-5
# OMP_MODEL=anthropic/claude-sonnet-5-5
# CRUSH_MODEL=anthropic/claude-sonnet-5-5
# AIDER_MODEL=sonnet
# GOOSE_PROVIDER=anthropic
# GOOSE_MODEL=claude-sonnet-5-5
# amp:          AMP_API_KEY (an sgamp_ access token)
# AMP_API_KEY=sgamp_...
# copilot-cli:  fine-grained PAT with the "Copilot Requests" permission
# COPILOT_GITHUB_TOKEN=github_pat_...
# devin-cli:    no API-key variable; run `devin auth login --force-manual-token-flow` once,
#               or mount ~/.local/share/devin/credentials.toml as a secret file
# droid:        FACTORY_API_KEY
# FACTORY_API_KEY=fk-...
# gemini-cli:   GEMINI_API_KEY
# GEMINI_API_KEY=...
# qwen-code:    any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://...
# OPENAI_MODEL=...

# ---- Optional ----
# PUSH=1
# CLAUDE_MAX_BUDGET_USD=2
# CODEX_SANDBOX=workspace-write
# DROID_AUTO=medium
# GIT_AUTHOR_NAME=cloud-coding-agent
# GIT_AUTHOR_EMAIL=cloud-coding-agent@users.noreply.github.com
